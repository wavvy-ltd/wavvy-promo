    { "id": "vo1",  "text": "Another M-Pesa message… and another. Where did your money go?", "start": 0.15, "duration": 3.39, "src": "assets/audio/vo_01.wav" },
    { "id": "vo2",  "text": "Meet Wavvy Wallet.", "start": 4.2, "duration": 1.23, "src": "assets/audio/vo_02.wav" },
