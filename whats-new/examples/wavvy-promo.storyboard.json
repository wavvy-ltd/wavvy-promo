    { "id": "vo9",  "text": "Fifty-two transactions, imported and categorized in seconds.", "start": 14.9, "duration": 3.75, "src": "assets/audio/vo_09.wav" },
    { "id": "vo4",  "text": "See exactly where your money goes, with clear reports.", "start": 20.5, "duration": 3.0, "src": "assets/audio/vo_04.wav" },
    { "id": "vo10", "text": "Your total for the month, at a glance. And every category, broken down.", "start": 24.2, "duration": 4.16, "src": "assets/audio/vo_10.wav" },
    { "id": "vo5",  "text": "Set budgets and spending limits, and get alerts before you overspend.", "start": 31.3, "duration": 3.84, "src": "assets/audio/vo_05.wav" },
    { "id": "vo11", "text": "Restaurants, shopping, transport. You choose the limit.", "start": 36.0, "duration": 3.05, "src": "assets/audio/vo_11.wav" },
    { "id": "vo6",  "text": "Just ask the AI: how much did I spend on food this month?", "start": 41.5, "duration": 3.43, "src": "assets/audio/vo_06.wav" },
    { "id": "vo12", "text": "Real answers, from your own transactions. No spreadsheets. No guessing.", "start": 46.0, "duration": 4.33, "src": "assets/audio/vo_12.wav" },
    { "id": "vo7",  "text": "Wavvy Wallet. Know where your money is going. Download it now, on the iOS App Store and on Android from Google Play.", "start": 52.3, "duration": 7.38, "src": "assets/audio/vo_07.wav" }
